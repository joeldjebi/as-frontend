# Vitrine (as.vite.ci) et boutique en ligne (as.vite.ci/acheter)
# Politique de sécurité propre au site : remplace celle héritée du dossier web du compte cPanel
<IfModule mod_headers.c>
  Header always unset Content-Security-Policy
  Header unset Content-Security-Policy
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://api.as.vite.ci https://*.wasabisys.com https://tile.openstreetmap.org https://*.basemaps.cartocdn.com; connect-src 'self' https://api.as.vite.ci wss://api.as.vite.ci; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
<IfModule mod_mime.c>
  AddType application/vnd.android.package-archive .apk
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.apk$">
    Header set Content-Disposition "attachment; filename=\"Adjame-Smart.apk\""
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
