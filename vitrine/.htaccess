# Vitrine Adjamé-Smart (as.vite.ci)
<IfModule mod_mime.c>
  AddType application/vnd.android.package-archive .apk
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.apk$">
    Header set Content-Disposition "attachment; filename=\"Adjame-Smart.apk\""
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
