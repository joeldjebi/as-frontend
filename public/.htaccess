# Back-office (sa.vite.ci) et espace boutique (boutique.vite.ci)
# Politique de sécurité propre au site : remplace celle héritée du dossier web du compte cPanel
<IfModule mod_headers.c>
  Header always unset Content-Security-Policy
  Header unset Content-Security-Policy
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://api.as.vite.ci https://*.wasabisys.com; connect-src 'self' https://api.as.vite.ci; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
