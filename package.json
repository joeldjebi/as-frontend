{
  "name": "as-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Adjamé-Smart : back-office (React + Vite)",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "tsc --noEmit && vite build && vite build --config vite.boutique.config.ts && vite build --config vite.site.config.ts",
    "preview": "vite preview",
    "dev:boutique": "vite --config vite.boutique.config.ts",
    "dev:site": "vite --config vite.site.config.ts"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
